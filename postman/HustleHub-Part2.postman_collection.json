{
  "info": {
    "_postman_id": "hustlehub-part2-secure-stack",
    "name": "HustleHub Part 2 - Secure Stack",
    "description": "Automated API tests for HustleHub Part 2 covering authentication, validation, RBAC, gigs, bookings, transactions, security headers and protected routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('clientEmail')) {",
          "    pm.environment.set('clientEmail', 'client.' + Date.now() + '@example.com');",
          "}",
          "",
          "if (!pm.environment.get('freelancerEmail')) {",
          "    pm.environment.set('freelancerEmail', 'freelancer.' + Date.now() + '@example.com');",
          "}",
          "",
          "if (!pm.environment.get('testPassword')) {",
          "    pm.environment.set('testPassword', 'SecurePass123!');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Register Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Client registration succeeds', function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('Response is JSON', function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "pm.test('Password is not exposed', function () {",
                  "    const body = pm.response.text();",
                  "    pm.expect(body).to.not.include(pm.environment.get('testPassword'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Client\",\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"client\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Register Freelancer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Freelancer registration succeeds', function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('Password is not exposed', function () {",
                  "    pm.expect(pm.response.text()).to.not.include(pm.environment.get('testPassword'));",
                  "});"
